# Postgres connection used by Prisma / the Next.js app
DATABASE_URL="postgresql://recon:recon@localhost:5432/recon?schema=public"

# Base URL of the mock payment provider's HTTP API (plain-JS simulator)
MOCK_PROVIDER_URL="http://localhost:4000"

# Shared secret used to sign/verify mock provider webhooks (HMAC-SHA256).
# Synthetic value only - never a real provider secret.
MOCK_PROVIDER_WEBHOOK_SECRET="whsec_local_dev_only_not_a_real_secret"

# Port the Next.js app listens on
PORT=3000
