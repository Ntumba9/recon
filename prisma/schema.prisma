// RECON data model.
//
// Orders and webhook events live here, on the app's side. The mock payment
// provider (mock-provider/) keeps its own independent store and is reached
// only through its HTTP API - this schema never represents provider state
// as truth, only as a local record of what the app observed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum RunStatus {
  SUCCESS
  INCONCLUSIVE
  FAILED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

/// Lifecycle of a FindingRecord. Only ever set by a human through the status
/// API, except for the automatic OPEN reopening of a RESOLVED finding whose
/// discrepancy recurs in a later complete run.
enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// What caused a FindingHistoryEntry: a human through the status API, or
/// the reconciler automatically reopening a RESOLVED finding.
enum HistoryChangeSource {
  MANUAL
  RECONCILIATION
}

/// What happened to a FindingRecord's note in one FindingHistoryEntry.
/// UNCHANGED covers both "note omitted from the request" and "the request
/// resubmitted the same text that was already there" - either way nothing
/// about the note actually changed.
enum NoteChangeType {
  UNCHANGED
  SET
  CLEARED
}

/// A booking in the business's own system. Booking state and payment state
/// are tracked separately on purpose: a CONFIRMED booking does not imply a
/// successful payment was ever observed, and vice versa.
model Order {
  id            String        @id @default(cuid())
  reference     String        @unique
  currency      String
  amountMinor   Int
  bookingStatus BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingStatus])
}

/// A raw webhook delivery from the mock provider, kept for audit and for
/// detecting webhook/provider disagreement. Never treated as proof of
/// payment by itself - see src/core/webhooks.
model WebhookEvent {
  id                String   @id @default(cuid())
  eventId           String   @unique
  providerPaymentId String
  orderReference    String?
  type              String
  signatureValid    Boolean
  payload           Json
  receivedAt        DateTime @default(now())

  @@index([providerPaymentId])
  @@index([orderReference])
}

/// One execution of the reconciler over a time window.
model ReconciliationRun {
  id                String      @id @default(cuid())
  startedAt         DateTime    @default(now())
  finishedAt        DateTime?
  windowStart       DateTime
  windowEnd         DateTime
  status            RunStatus
  providerAvailable Boolean     @default(true)
  notes             String?
  occurrences       FindingOccurrence[]
  historyEntries    FindingHistoryEntry[]
}

/// The stable identity of a finding. The same underlying discrepancy
/// (e.g. "order X has a successful payment but is not confirmed") keeps the
/// same findingKey across reruns, so reruns update firstSeen/lastSeen
/// instead of creating duplicate findings.
model FindingRecord {
  id                String   @id @default(cuid())
  findingKey        String   @unique
  mismatchClass     String
  orderReference    String?
  providerPaymentId String?
  currency          String?
  amountMinor       Int?
  firstSeenRunId    String
  lastSeenRunId     String
  status            FindingStatus @default(OPEN)
  note              String?
  statusChangedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Optimistic-concurrency token: incremented on every write to this row
  /// (status/note changes and reconciliation touches alike). A write
  /// conditioned on the version it read affecting zero rows means someone
  /// else committed first - see src/app/api/findings/[id]/status/route.ts
  /// and src/core/reconciler/runReconciliation.ts.
  version Int @default(1)

  occurrences FindingOccurrence[]
  history     FindingHistoryEntry[]

  @@index([mismatchClass])
  @@index([orderReference])
  @@index([status])
}

/// One recorded change to a FindingRecord's status and/or note - append
/// only, never updated or deleted, so it stays a trustworthy audit trail
/// independent of the record's current (mutable) state. Entries exist only
/// for changes made after this feature shipped; no history is fabricated
/// for a record's earlier life.
model FindingHistoryEntry {
  id              String        @id @default(cuid())
  findingRecordId String
  findingRecord   FindingRecord @relation(fields: [findingRecordId], references: [id])

  previousStatus FindingStatus
  newStatus      FindingStatus

  changeSource HistoryChangeSource
  noteChangeType NoteChangeType
  /// The note's new value - set only when noteChangeType is SET; null for
  /// UNCHANGED and CLEARED alike (a cleared note's new value is always null).
  newNote String?

  /// Set only when changeSource is RECONCILIATION (an automatic reopen);
  /// null for every manual, human-driven change.
  sourceRunId String?
  sourceRun   ReconciliationRun? @relation(fields: [sourceRunId], references: [id])

  createdAt DateTime @default(now())
  /// Monotonically increasing per row, independent of wall-clock
  /// resolution, so timeline ordering stays deterministic even when two
  /// entries share the same createdAt millisecond.
  sequence  Int      @default(autoincrement())

  @@index([findingRecordId, sequence])
}

/// One run's evidence for a given FindingRecord. Preserves run history
/// (what evidence looked like at the time) without duplicating identity.
model FindingOccurrence {
  id              String   @id @default(cuid())
  findingRecordId String
  findingRecord   FindingRecord     @relation(fields: [findingRecordId], references: [id])
  runId           String
  run             ReconciliationRun @relation(fields: [runId], references: [id])
  severity        Severity
  evidence        Json
  createdAt       DateTime @default(now())

  @@unique([findingRecordId, runId])
  @@index([runId])
}
