{
  "name": "recon",
  "version": "0.1.0",
  "private": true,
  "description": "Payment reconciliation tool for synthetic bookings vs. a mock payment provider.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "mock-provider": "node mock-provider/server.js",
    "demo": "tsx scripts/demo.ts",
    "secret-scan": "node scripts/secret-scan.js"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "next": "16.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prisma": "5.20.0",
    "tsx": "4.23.15",
    "typescript": "5.5.4",
    "vitest": "5.1.0",
    "eslint": "9.39.5",
    "@eslint/eslintrc": "3.3.7",
    "eslint-config-next": "16.4.6"
  },
  "engines": {
    "node": ">=20"
  }
}
